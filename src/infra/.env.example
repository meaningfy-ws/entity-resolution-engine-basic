# ERE local development environment
# Copy to infra/.env and customise: cp infra/.env.example infra/.env
#
# Compatible with the ERSys unified environment (infra/.env.example).
# When running ERE standalone, use this file with infra/compose.dev.yaml.
# When running inside the full ERSys stack, the parent project's .env covers these.

# --- Redis ---
# When running the demo from the host machine (poetry run python demo/demo.py),
# the Docker service name 'ersys-redis' is not resolvable from the host. Set
# REDIS_HOST=localhost here before running the demo. The ERE container reads this
# file at startup, so restore the original value before restarting the stack.
REDIS_HOST=ersys-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# --- Queues ---
ERSYS_REQUEST_QUEUE=ere_requests
ERSYS_RESPONSE_QUEUE=ere_responses

# --- Storage ---
DUCKDB_PATH=/data/app.duckdb
# disk (default) or memory. On disk, DuckDB spills to <DUCKDB_PATH>.tmp unless ERE_DUCKDB_TEMP_DIR is set.
ERE_DUCKDB_STORAGE=disk
# Set explicitly in containers (~60% of the container memory limit); DuckDB otherwise sizes it from host RAM.
ERE_DUCKDB_MEMORY_LIMIT=2GB
# ERE_DUCKDB_THREADS=2
# ERE_DUCKDB_TEMP_DIR=/data/duckdb-spill
# Trained similarity model file; default <DUCKDB_PATH>.splink_model.json
# ERE_SPLINK_MODEL_PATH=/data/app.duckdb.splink_model.json

# --- Bites (requests taken from the queue together) ---
# A bite holds the waiting requests the ERE can process in about ERE_BATCH_TARGET_SECONDS,
# bounded by ERE_BATCH_MAX_MENTIONS and ERE_BATCH_MAX_BYTES. Requests beyond the bite stay in Redis.
# ERE_BATCH_TARGET_SECONDS=2
# ERE_BATCH_MAX_MENTIONS=500
# ERE_BATCH_MAX_BYTES=50000000
# ERE_BATCH_LINGER_MS=250

# --- Logging ---
# ERE_LOG_LEVEL is read directly by the application (src/ere/utils/logging.py).
ERE_LOG_LEVEL=INFO
